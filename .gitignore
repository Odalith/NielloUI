# Prebuilt native backends are downloaded, not committed
# (tools/fetch-native.sh). Keep the READMEs and placeholders.
third_party/native/**
!third_party/native/**/
!third_party/native/**/README.md
!third_party/native/**/.gitkeep
# The bundled SDL3 fetch-native.sh drops beside them (Linux; the Windows
# DLL and import library too)
/third_party/sdl3/

